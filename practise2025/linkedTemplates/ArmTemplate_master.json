{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "practise2025"
		},
		"AzureBlobStorage1_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'AzureBlobStorage1'"
		},
		"csvfiles_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'csvfiles'"
		},
		"test_SqlDatabase_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'test_SqlDatabase'"
		},
		"AzureBlobStorage2_properties_typeProperties_connectionString_secretName": {
			"type": "string",
			"defaultValue": "testblobkeyvalue"
		},
		"AzureGen2Storage1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://storagegen22025.dfs.core.windows.net/"
		},
		"KeyVaultlinkedservice_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://testpractisekeyvault2025.vault.azure.net/"
		},
		"KeyVaultpractice_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://practicekeyvault2025.vault.azure.net/"
		},
		"test_SqlDatabase_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "testsqlserver2025.database.windows.net"
		},
		"test_SqlDatabase_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "testsqldb"
		},
		"test_SqlDatabase_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sravan"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "practise2025_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureBlobStorage1_connectionString": {
						"value": "[parameters('AzureBlobStorage1_connectionString')]"
					},
					"csvfiles_connectionString": {
						"value": "[parameters('csvfiles_connectionString')]"
					},
					"test_SqlDatabase_password": {
						"value": "[parameters('test_SqlDatabase_password')]"
					},
					"KeyVaultlinkedservice_properties_typeProperties_baseUrl": {
						"value": "[parameters('KeyVaultlinkedservice_properties_typeProperties_baseUrl')]"
					},
					"KeyVaultpractice_properties_typeProperties_baseUrl": {
						"value": "[parameters('KeyVaultpractice_properties_typeProperties_baseUrl')]"
					},
					"test_SqlDatabase_properties_typeProperties_server": {
						"value": "[parameters('test_SqlDatabase_properties_typeProperties_server')]"
					},
					"test_SqlDatabase_properties_typeProperties_database": {
						"value": "[parameters('test_SqlDatabase_properties_typeProperties_database')]"
					},
					"test_SqlDatabase_properties_typeProperties_userName": {
						"value": "[parameters('test_SqlDatabase_properties_typeProperties_userName')]"
					},
					"AzureBlobStorage2_properties_typeProperties_connectionString_secretName": {
						"value": "[parameters('AzureBlobStorage2_properties_typeProperties_connectionString_secretName')]"
					},
					"AzureGen2Storage1_properties_typeProperties_url": {
						"value": "[parameters('AzureGen2Storage1_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "practise2025_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'practise2025_ArmTemplate_0')]"
			]
		}
	]
}