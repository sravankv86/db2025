{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "practise2025"
		},
		"AzureBlobStorage1_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'AzureBlobStorage1'"
		},
		"csvfiles_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'csvfiles'"
		},
		"test_SqlDatabase_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'test_SqlDatabase'"
		},
		"KeyVaultlinkedservice_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://testpractisekeyvault2025.vault.azure.net/"
		},
		"KeyVaultpractice_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://practicekeyvault2025.vault.azure.net/"
		},
		"test_SqlDatabase_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "testsqlserver2025.database.windows.net"
		},
		"test_SqlDatabase_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "testsqldb"
		},
		"test_SqlDatabase_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sravan"
		},
		"AzureBlobStorage2_properties_typeProperties_connectionString_secretName": {
			"type": "string",
			"defaultValue": "testblobkeyvalue"
		},
		"AzureGen2Storage1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://storagegen22025.dfs.core.windows.net/"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
